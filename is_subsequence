/*
Approach
Two Pointer

Complexity
Time complexity:O(n)
Space complexity:O(1)
*/
class Solution {
public:
    bool isSubsequence(string s, string t) {
        if(s==""){
            return true;
        }
        int i = 0, j = 0;
        while (i<s.size() && j < t.size()) {
            if (s[i] == t[j]) {
                i++;
            }
            j++;
        }
        return i==s.size();
    }
};
