/*
Approach
Optimal

Complexity
Time complexity:O(n)
Space complexity:O(1)
*/

class Solution {
public:
    bool increasingTriplet(vector<int>& nums) {
        int num1 = INT_MAX,num2 = INT_MAX;

        for (auto n : nums) {
            if (num1 >= n) {
                num1 = n;
            } else if (num2 >= n) {
                num2 = n;
            } else {
                return true;
            }
        }
        return false;
    }
};
