/*
Approach
Two Pointers

Complexity
Time complexity:O(n)
Space complexity:O(1)
*/

class Solution {
public:
    void moveZeroes(vector<int>& nums) {
       
        for(int r=0, l=0;r < nums.size();r++){
            if(nums[r] !=0){
                swap(nums[l],nums[r]);
                l++;
            }
        }
    }
};
