/*Intuition
Reverse the entire string. then check for the first whitespace and reverse the word before it

Approach
Two-pass string reversal
Complexity
Time complexity:O(n)
Space complexity:O(1)*/
class Solution {
public:
    string reverseWords(string s) {
        /*Removing starting and trailing spaces*/
       while (!s.empty() && s.front() == ' ') s.erase(s.begin());  
        while (!s.empty() && s.back() == ' ') s.pop_back();        
        
        reverse(s.begin(), s.end());

        size_t start = 0;
        size_t end = s.find(' ', start);

        while (end >0 && end <s.size()) {  
            reverse(s.begin() + start, s.begin() + end);
    
            while (end + 1 < s.size() && s[end + 1] == ' ') {
                // remove extra  whitespace
                 s.erase(end + 1, 1);  
                }

            start = end + 1;
            end = s.find(' ', start);
        }

        reverse(s.begin() + start, s.end());

        return s;
    }
}
;
