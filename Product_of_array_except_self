/*
Intuition
Calculate the prodduct of left part of array(prefix) and right partbof array(suufix) and multiply them.

Approach
Prefix and sufix product

Complexity
Time complexity:O(n)
Space complexity:O(1)
*/

class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        vector<int> ans((nums.size()), 1);
        for (int i = 1; i < nums.size(); i++) {
            ans[i] = ans[i - 1] * nums[i - 1];
        }
        int suff = 1;
        for (int i = nums.size() - 2; i >= 0; i--) {
            suff *= nums[i + 1];
            ans[i] *= suff;
        }
        return ans;
    }
};
