#include <iostream>
using namespace std;
/*Approch- Two Pointer
 Time Complexcity- O(max(m,n)) where m,n is leangth of both the string respectivly
 Space Complecxcity- O(m+n) size of merged array */

string mergeAlternately(string word1, string word2)
{
    int i = 0, j = 0, k = 0;
    string merged;
    while (i < word1.size() || j < word2.size())
    {
        if (i < word1.size())
        {
            merged += word1[i++]; // concatinating string
        }
        if (j < word2.size())
        {
            merged += word2[j++];
        }
    }

    return merged;
}
int main()
{
    string word1 = "abcdef";
    string word2 = "pqrs";
    cout << mergeAlternately(word1, word2);

    return 0;
}
