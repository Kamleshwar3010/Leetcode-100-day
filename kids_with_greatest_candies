/*
Greedy
- assign max candies possible
Time Complexcity: O(n)
Space Complexcity: O(n) for storing answer
*/
class Solution {
public:
    vector<bool> kidsWithCandies(vector<int>& candies, int extraCandies) {
        vector <bool> v;
        int max=candies[0];
        for(int n: candies){
            if (n>max){
                max=n;
            }
        }
        for(int n:candies){
            if(n+extraCandies < max){
                v.push_back(false);
            }
            else{
                v.push_back(true);
            }
        }
        return v;
    }
};
